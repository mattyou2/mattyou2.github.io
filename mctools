/* ---------------- Ability section ---------------- */
function renderAbilitySection(item){
  const d=document.createElement('div');
  const grid=document.createElement('div');
  grid.className='ability-grid';
  Object.entries(ABILITY_DEFS).forEach(([type,def])=>{
    const active=item.abilities.find(a=>a.type===type);
    const tile=document.createElement('div');
    tile.className='ability-tile'+(active?' on':'');
    tile.innerHTML=`
      <div class="at-h"><b>${def.label}</b><span class="trig">${def.trigger==='use'?'Rechtsklik':(def.trigger==='hit'?'Bij raak':'Terwijl vastgehouden')}</span></div>
      <p>${def.desc}</p>
    `;
    if(active){
      const params=document.createElement('div');
      params.className='ability-params';
      def.params.forEach(p=>{
        const f=document.createElement('div');
        f.className='field';
        f.innerHTML=`<label>${p.label}</label><input type="number" data-k="${p.k}" min="${p.min}" max="${p.max}" value="${active.params[p.k]}">`;
        f.querySelector('input').onclick=e=>e.stopPropagation();
        f.querySelector('input').onchange=e=>{ active.params[p.k]=parseFloat(e.target.value)||0; };
        params.appendChild(f);
      });
      tile.appendChild(params);
    }
    tile.onclick=(e)=>{
      if(e.target.tagName==='INPUT') return;
      if(active){ item.abilities=item.abilities.filter(a=>a.type!==type); }
      else{
        const params={}; def.params.forEach(p=>params[p.k]=p.def);
        item.abilities.push({type,params});
      }
      render();
    };
    grid.appendChild(tile);
  });
  d.appendChild(grid);
  const hint=document.createElement('div');
  hint.className='hint-box';
  hint.innerHTML=`Abilities die bij <b>raak</b> triggeren gebruiken het advancement <code>player_hurt_entity</code> — dit werkt volledig vanilla.
    Abilities bij <b>rechtsklik</b> gebruiken de "consumable"-truc (werkt het best vanaf 1.20.5+). "Terwijl vastgehouden" geeft continu een effect zolang het item in je hand zit.`;
  d.appendChild(hint);
  return d;
}

/* ---------------- Recipe section ---------------- */
function renderRecipeSection(item){
  if(!item.recipe) item.recipe={enabled:false,shaped:true,grid:['','','','','','','','',''],count:1};
  const r=item.recipe;
  const d=document.createElement('div');
  d.innerHTML=`
    <div class="checkbox-line"><input type="checkbox" id="recipeEnabled" ${r.enabled?'checked':''}> <label style="margin:0;">Geef dit item een crafting-recipe</label></div>
    <div id="recipeBody" style="${r.enabled?'':'display:none;'}">
      <div class="field-row">
        <button class="mc-btn small ${r.shaped?'primary':'ghost'}" id="shapedBtn">Shaped (exacte layout)</button>
        <button class="mc-btn small ${!r.shaped?'primary':'ghost'}" id="shapelessBtn">Shapeless (elke layout)</button>
      </div>
      <div class="recipe-wrap">
        <div class="recipe-grid" id="recipeGrid">
          ${r.grid.map((v,i)=>`<div class="recipe-slot"><input type="text" data-i="${i}" value="${escapeHtml(v)}" placeholder="—"></div>`).join('')}
        </div>
        <div>→</div>
        <div class="field" style="max-width:100px;"><label>Levert</label><input type="number" id="recipeCount" min="1" max="64" value="${r.count}"></div>
      </div>
      <div class="hint-box">Typ een vanilla item-id per vak (bijv. <code>diamond</code>, <code>stick</code>) of een tag zoals <code>#planks</code>. Laat een vak leeg voor geen item op die plek.</div>
    </div>
  `;
  setTimeout(()=>{
    d.querySelector('#recipeEnabled').onchange=e=>{ r.enabled=e.target.checked; render(); };
    const shapedBtn=d.querySelector('#shapedBtn'); const shapelessBtn=d.querySelector('#shapelessBtn');
    if(shapedBtn) shapedBtn.onclick=()=>{ r.shaped=true; render(); };
    if(shapelessBtn) shapelessBtn.onclick=()=>{ r.shaped=false; render(); };
