<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blokwerk — Minecraft Tools</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
:root{
  --stone-900:#161310; --stone-800:#211d18; --stone-700:#2c2620; --stone-600:#3a332a;
  --panel:#252019; --slot-bg:#3d3d3d; --slot-light:#ffffff; --slot-dark:#373737;
  --gold:#ffb400; --enchant:#a24bd6; --xp:#7de84a; --redstone:#c73a3a; --diamond:#5fd9d0;
  --text:#e9e2d3; --text-dim:#a89f8c; --danger:#c73a3a;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;}
body{
  background:
    radial-gradient(circle at 20% 10%, #2a2419 0, transparent 40%),
    repeating-linear-gradient(45deg, var(--stone-900) 0 2px, var(--stone-800) 2px 4px),
    var(--stone-900);
  color:var(--text); font-family:'Courier New',Consolas,monospace; min-height:100vh;
}
::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:var(--stone-800);}
::-webkit-scrollbar-thumb{background:var(--stone-600);border:2px solid var(--stone-800);}
.pixel-font{font-family:'Courier New',monospace;letter-spacing:1px;text-shadow:2px 2px 0 rgba(0,0,0,0.6);}
.panel{
  background:var(--panel);
  border-top:3px solid #4a4234;border-left:3px solid #4a4234;
  border-bottom:3px solid #0e0c09;border-right:3px solid #0e0c09;
  box-shadow: inset 0 0 0 2px #1a160f;
}
button.mc-btn{
  font-family:inherit;background:#8b8b8b;color:#161310;font-weight:bold;padding:9px 16px;
  border-top:3px solid #fff;border-left:3px solid #fff;border-bottom:3px solid #383838;border-right:3px solid #383838;
  cursor:pointer;filter:brightness(0.62);font-size:13px;text-shadow:1px 1px 0 rgba(0,0,0,0.3);transition:filter .08s;
}
button.mc-btn:hover{filter:brightness(0.78);}
button.mc-btn:active{border-top:3px solid #383838;border-left:3px solid #383838;border-bottom:3px solid #fff;border-right:3px solid #fff;}
button.mc-btn.primary{background:var(--xp);}
button.mc-btn.gold{background:var(--gold);}
button.mc-btn.danger{background:#e05a5a;}
button.mc-btn.ghost{background:#5a5346;}
button.mc-btn:disabled{filter:brightness(0.3);cursor:not-allowed;}
button.mc-btn.small{padding:5px 10px;font-size:11px;}
input[type=text],input[type=number],input[type=email],input[type=password],select,textarea{
  font-family:inherit;background:#131110;color:var(--text);
  border-top:2px solid var(--slot-dark);border-left:2px solid var(--slot-dark);
  border-bottom:2px solid #55503f;border-right:2px solid #55503f;padding:7px 9px;font-size:13px;width:100%;
}
input[type=text]:focus,input[type=number]:focus,select:focus{outline:2px solid var(--gold);}
label{font-size:11px;color:var(--text-dim);display:block;margin-bottom:4px;letter-spacing:.5px;}
a{color:var(--diamond);}
.app{min-height:100vh;display:flex;flex-direction:column;}
header.topbar{
  padding:14px 22px;background:linear-gradient(180deg,#2c2620,#211d18);border-bottom:4px solid #0e0c09;
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
}
header.topbar .logo{font-size:18px;color:var(--gold);cursor:pointer;}
header.topbar .crumb{color:var(--text-dim);font-size:12px;}
header.topbar .spacer{flex:1;}
.account-box{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-dim);}
.account-box b{color:var(--diamond);}
main{flex:1;padding:22px;max-width:1500px;margin:0 auto;width:100%;}
.hero{text-align:center;padding:40px 10px 30px;}
.hero h1{font-size:26px;color:var(--gold);margin:0 0 10px;}
.hero p{color:var(--text-dim);max-width:560px;margin:0 auto;font-size:13px;line-height:1.7;}
.tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px;margin-top:30px;}
.tool-card{padding:20px;cursor:pointer;position:relative;}
.tool-card.disabled{cursor:not-allowed;opacity:.5;}
.tool-card .icon{
  width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:12px;
  background:var(--slot-bg);border-top:3px solid var(--slot-light);border-left:3px solid var(--slot-light);
  border-bottom:3px solid var(--slot-dark);border-right:3px solid var(--slot-dark);
}
.tool-card h3{margin:0 0 6px;font-size:14px;}
.tool-card p{margin:0;font-size:12px;color:var(--text-dim);line-height:1.5;}
.badge-soon{position:absolute;top:12px;right:12px;background:var(--redstone);color:#fff;font-size:9px;padding:3px 6px;}

.dm-toolbar{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;padding:14px;margin-bottom:16px;}
.dm-toolbar .field{min-width:150px;}
.dm-toolbar .spacer{flex:1;}
.dm-grid{display:grid;grid-template-columns:280px 1fr;gap:16px;align-items:start;}
@media (max-width:900px){.dm-grid{grid-template-columns:1fr;}}

.items-panel{padding:12px;max-height:82vh;overflow:auto;}
.items-panel .addnew{width:100%;margin-bottom:12px;}
.empty-hint{color:var(--text-dim);font-size:12px;padding:30px 10px;text-align:center;line-height:1.8;}
.set-group{margin-bottom:14px;}
.set-group .set-title{
  font-size:11px;color:var(--text-dim);margin-bottom:6px;letter-spacing:.5px;display:flex;align-items:center;gap:6px;
}
.set-group .set-title .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.set-group .set-title .badge{background:var(--stone-600);padding:1px 6px;font-size:9px;color:var(--text-dim);margin-left:auto;}
.item-card{
  display:flex;align-items:center;gap:8px;padding:7px 8px;margin-bottom:5px;cursor:pointer;
  background:var(--stone-700);border-left:3px solid transparent;
}
.item-card:hover{border-left:3px solid var(--gold);background:var(--stone-600);}
.item-card.selected{border-left:3px solid var(--xp);background:var(--stone-600);}
.item-card .thumb{
  width:30px;height:30px;background:var(--slot-bg) repeating-conic-gradient(#4a4a4a 0 25%,#3a3a3a 0 50%) 0 0/8px 8px;
  border:2px solid #000;flex-shrink:0;image-rendering:pixelated;
}
.item-card .thumb img{width:100%;height:100%;image-rendering:pixelated;}
.item-card .meta{flex:1;min-width:0;}
.item-card .meta .nm{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.item-card .meta .sub{font-size:9px;color:var(--text-dim);display:flex;gap:4px;align-items:center;}
.item-card .meta .ab-badge{background:var(--enchant);color:#fff;padding:1px 4px;font-size:8px;border-radius:2px;}
.item-card .del{color:var(--danger);cursor:pointer;font-size:13px;padding:2px 5px;}
.item-card .del:hover{color:#ff8b8b;}

.editor-panel{padding:0;min-height:82vh;}
.editor-panel .placeholder{color:var(--text-dim);font-size:12px;text-align:center;padding:60px 10px;}
.editor-scroll{max-height:82vh;overflow:auto;padding:16px;}
.editor-head{display:flex;gap:14px;align-items:flex-start;margin-bottom:18px;}
.editor-head .bigthumb{
  width:64px;height:64px;background:var(--slot-bg) repeating-conic-gradient(#4a4a4a 0 25%,#3a3a3a 0 50%) 0 0/10px 10px;
  border:3px solid #000;flex-shrink:0;
}
.editor-head .bigthumb img{width:100%;height:100%;image-rendering:pixelated;}
.editor-head .hd-fields{flex:1;}
.section{margin-bottom:22px;padding-top:14px;border-top:2px solid var(--stone-700);}
.section:first-of-type{border-top:none;padding-top:0;}
.section h4{margin:0 0 4px;font-size:12px;color:var(--gold);text-transform:uppercase;letter-spacing:1px;}
.section .sub-desc{font-size:11px;color:var(--text-dim);margin-bottom:10px;}
.field-row{display:flex;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
.field{flex:1;min-width:110px;}
.color-swatches{display:flex;flex-wrap:wrap;gap:5px;margin-top:4px;}
.swatch{width:22px;height:22px;cursor:pointer;border:2px solid #000;}
.swatch.active{outline:2px solid #fff;outline-offset:1px;}
.name-preview{padding:10px 12px;background:#000;margin-top:10px;font-size:15px;border:2px solid #333;}
.format-toggles{display:flex;gap:6px;margin-top:6px;}
.toggle-chip{font-size:11px;padding:5px 9px;background:var(--stone-700);cursor:pointer;color:var(--text-dim);}
.toggle-chip.on{background:var(--gold);color:#161310;font-weight:bold;}
.row-list{display:flex;flex-direction:column;gap:6px;margin-bottom:10px;}
.row-item{display:flex;gap:6px;align-items:center;background:var(--stone-700);padding:6px 8px;flex-wrap:wrap;}
.row-item select,.row-item input{flex:1;min-width:90px;}
.row-item .rm{color:var(--danger);cursor:pointer;padding:0 4px;font-size:14px;}
.hint-box{background:var(--stone-800);padding:10px 12px;font-size:11px;color:var(--text-dim);line-height:1.7;margin-top:10px;}
.checkbox-line{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text);margin-bottom:8px;}
.checkbox-line input{width:auto;}

/* ability grid */
.ability-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
@media (max-width:600px){.ability-grid{grid-template-columns:1fr;}}
.ability-tile{background:var(--stone-700);padding:10px 12px;cursor:pointer;border:2px solid transparent;}
.ability-tile:hover{background:var(--stone-600);}
.ability-tile.on{border-color:var(--enchant);background:var(--stone-600);}
.ability-tile .at-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;}
.ability-tile b{font-size:12px;}
.ability-tile .trig{font-size:9px;background:var(--stone-800);padding:2px 5px;color:var(--text-dim);}
.ability-tile p{margin:0;font-size:10px;color:var(--text-dim);line-height:1.4;}
.ability-params{background:var(--stone-800);padding:8px;margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;}
.ability-params .field{min-width:100px;}

/* recipe grid */
.recipe-grid{display:grid;grid-template-columns:repeat(3,64px);gap:6px;margin:10px 0;}
.recipe-slot{
  width:64px;height:64px;background:var(--slot-bg);border-top:3px solid var(--slot-dark);border-left:3px solid var(--slot-dark);
  border-bottom:3px solid var(--slot-light);border-right:3px solid var(--slot-light);filter:brightness(0.6);
  display:flex;align-items:center;justify-content:center;
}
.recipe-slot input{
  background:transparent;border:none;text-align:center;font-size:9px;color:#fff;width:100%;padding:2px;filter:brightness(2.2);
}
.recipe-wrap{display:flex;align-items:center;gap:16px;flex-wrap:wrap;}

/* texture editor */
.pixel-editor-wrap{display:flex;gap:18px;flex-wrap:wrap;}
.pixel-toolcol{display:flex;flex-direction:column;gap:8px;width:170px;}
.pixel-tool-btn{
  font-family:inherit;background:var(--stone-700);color:var(--text);border:none;padding:8px;font-size:11px;
  cursor:pointer;text-align:left;
}
.pixel-tool-btn.active{background:var(--gold);color:#161310;font-weight:bold;}
#pixelCanvas{
  image-rendering:pixelated;cursor:crosshair;
  background-image:repeating-conic-gradient(#555 0 25%,#3a3a3a 0 50%);background-size:16px 16px;border:3px solid #000;
}
.color-picker-row{display:flex;align-items:center;gap:8px;margin-top:4px;}
.current-color-box{width:26px;height:26px;border:2px solid #fff;flex-shrink:0;}
.hex-input{max-width:110px;}
.upload-label{
  display:block;text-align:center;background:var(--stone-700);color:var(--text);padding:8px;font-size:11px;cursor:pointer;
}
.upload-label:hover{background:var(--stone-600);}

/* modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.72);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px;}
.modal-box{width:100%;max-width:640px;max-height:88vh;overflow:auto;padding:20px;}
.modal-box h2{margin:0 0 16px;font-size:16px;color:var(--gold);}
.type-choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px;}
.type-choice{padding:14px;background:var(--stone-700);cursor:pointer;text-align:center;}
.type-choice:hover{background:var(--stone-600);}
.type-choice.selected{background:var(--stone-600);outline:2px solid var(--gold);}
.type-choice .ti{font-size:22px;margin-bottom:6px;}
.type-choice .tn{font-size:12px;}
.checklist{max-height:220px;overflow:auto;background:var(--stone-800);padding:8px;}
.checklist label{display:flex;align-items:center;gap:6px;color:var(--text);font-size:12px;padding:3px 0;}
.auth-tabs{display:flex;gap:6px;margin-bottom:14px;}
.auth-tabs button{flex:1;}
.mypacks-row{display:flex;justify-content:space-between;align-items:center;background:var(--stone-700);padding:8px 10px;margin-bottom:6px;}
.mypacks-row .mp-meta{font-size:11px;color:var(--text-dim);}
.error-msg{color:#ff8b8b;font-size:12px;margin-top:8px;}
.ok-msg{color:var(--xp);font-size:12px;margin-top:8px;}

.toast{position:fixed;bottom:20px;right:20px;padding:12px 18px;background:var(--xp);color:#0e2600;font-size:13px;font-weight:bold;z-index:200;box-shadow:0 4px 12px rgba(0,0,0,.4);}
footer.foot{text-align:center;padding:20px;color:var(--text-dim);font-size:11px;}
</style>
