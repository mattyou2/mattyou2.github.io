<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My-OS</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; user-select:none; }
  body { font-family: 'Segoe UI', Tahoma, sans-serif; background:#1a1a2e; overflow:hidden; height:100vh; }
  #login-screen {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    height:100%; background:linear-gradient(135deg, #16213e, #0f3460);
    color:white;
  }
  #login-screen h1 { font-size:3rem; margin-bottom:20px; text-shadow:0 0 20px #e94560; }
  #login-screen form { background:rgba(255,255,255,0.08); padding:30px; border-radius:16px; backdrop-filter:blur(8px); width:300px; }
  #login-screen input { display:block; width:100%; padding:12px; margin:12px 0; border:none; border-radius:8px; background:rgba(255,255,255,0.2); color:white; font-size:1rem; }
  #login-screen input::placeholder { color:#ccc; }
  #login-screen button { width:100%; padding:12px; border:none; border-radius:8px; background:#e94560; color:white; font-size:1.1rem; cursor:pointer; margin-top:8px; transition:0.2s; }
  #login-screen button:hover { background:#c73650; }
  #login-screen .error { color:#ff6b6b; margin-top:8px; text-align:center; }
  #login-screen .switch { margin-top:12px; text-align:center; cursor:pointer; color:#a0d2db; text-decoration:underline; }

  #desktop {
    display:none; width:100vw; height:100vh; background:#1a1a2e; position:relative;
    background-image: radial-gradient(circle at 20% 30%, #2a2a4a 0%, transparent 30%),
                      radial-gradient(circle at 80% 70%, #3a2a4a 0%, transparent 30%);
    overflow:hidden;
  }
  #taskbar {
    position:absolute; bottom:0; left:0; right:0; height:50px;
    background:rgba(20,20,40,0.9); backdrop-filter:blur(10px);
    display:flex; align-items:center; padding:0 10px; border-top:1px solid #3a3a5a;
    z-index:1000;
  }
  #start-btn {
    background:#e94560; color:white; border:none; padding:8px 16px; border-radius:8px;
    font-weight:bold; cursor:pointer; margin-right:12px;
  }
  #taskbar .task { padding:4px 12px; margin:0 4px; background:rgba(255,255,255,0.1); border-radius:6px; color:white; cursor:pointer; white-space:nowrap; }
  #taskbar .task.active { background:#e94560; }
  #clock { margin-left:auto; color:white; padding:0 12px; font-size:0.9rem; }

  .window {
    position:absolute; min-width:300px; min-height:200px; background:#2a2a3e;
    border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,0.6);
    display:flex; flex-direction:column; overflow:hidden; resize:both;
  }
  .window .titlebar {
    background:#3a3a5a; padding:8px 12px; display:flex; justify-content:space-between;
    align-items:center; cursor:move; border-radius:12px 12px 0 0;
  }
  .window .titlebar span { color:white; font-weight:bold; }
  .window .titlebar button { background:transparent; border:none; color:white; font-size:1.2rem; cursor:pointer; margin-left:6px; }
  .window .content { flex:1; padding:12px; overflow:auto; color:white; background:#1e1e30; }

  /* App-specifieke stijlen */
  .app-notepad textarea { width:100%; height:100%; background:#1a1a2e; color:#0f0; border:none; resize:none; font-family:monospace; padding:8px; }
  .app-calculator { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
  .app-calculator button { padding:16px; font-size:1.2rem; border:none; border-radius:8px; background:#3a3a5a; color:white; cursor:pointer; }
  .app-calculator .display { grid-column:span 4; background:#1a1a2e; padding:12px; text-align:right; font-size:1.8rem; border-radius:8px; }
  .app-filemanager .file { padding:6px 12px; border-bottom:1px solid #3a3a5a; cursor:pointer; }
  .app-filemanager .file:hover { background:#3a3a5a; }
</style>
</head>
<body>
<div id="login-screen">
  <h1>My-OS</h1>
  <form id="login-form">
    <h2 style="margin-bottom:10px;" id="form-title">Inloggen</h2>
    <input type="text" id="login-username" placeholder="Gebruikersnaam" required>
    <input type="password" id="login-password" placeholder="Wachtwoord" required>
    <button type="submit" id="login-submit">Inloggen</button>
    <div class="error" id="login-error"></div>
    <div class="switch" id="switch-to-register">Nog geen account? Registreer</div>
  </form>
</div>

<div id="desktop">
  <div id="taskbar">
    <button id="start-btn">Start</button>
    <div id="task-list"></div>
    <div id="clock"></div>
  </div>
  <!-- Windows worden hier dynamisch toegevoegd -->
</div>

<script>
// ========== GLOBALE STATE ==========
let currentUser = null;
let windows = [];
let windowIdCounter = 0;
let zIndexCounter = 100;
const APPS = ['notepad', 'calculator', 'klok', 'bestandsbeheer'];

// ========== ACCOUNT BEHEER ==========
function getUsers() {
  return JSON.parse(localStorage.getItem('myos_users') || '{}');
}
function saveUsers(users) {
  localStorage.setItem('myos_users', JSON.stringify(users));
}
function getUserData(username) {
  const users = getUsers();
  return users[username] ? users[username].data : null;
}
function setUserData(username, data) {
  const users = getUsers();
  if (users[username]) {
    users[username].data = data;
    saveUsers(users);
  }
}
function getDefaultData() {
  return {
    notepad: [],
    calculator: [],
    files: []
  };
}

// ========== LOGIN / REGISTRATIE ==========
const loginScreen = document.getElementById('login-screen');
const desktop = document.getElementById('desktop');
const loginForm = document.getElementById('login-form');
const formTitle = document.getElementById('form-title');
const loginSubmit = document.getElementById('login-submit');
const loginError = document.getElementById('login-error');
const switchBtn = document.getElementById('switch-to-register');
let isRegister = false;

switchBtn.addEventListener('click', () => {
  isRegister = !isRegister;
  formTitle.textContent = isRegister ? 'Registreren' : 'Inloggen';
  loginSubmit.textContent = isRegister ? 'Registreer' : 'Inloggen';
  switchBtn.textContent = isRegister ? 'Al een account? Log in' : 'Nog geen account? Registreer';
  loginError.textContent = '';
});

loginForm.addEventListener('submit', (e) => {
  e.preventDefault();
  const username = document.getElementById('login-username').value.trim();
  const password = document.getElementById('login-password').value.trim();
  const users = getUsers();
  loginError.textContent = '';

  if (isRegister) {
    if (users[username]) {
      loginError.textContent = 'Gebruiker bestaat al.';
      return;
    }
    users[username] = { password: password, data: getDefaultData() };
    saveUsers(users);
    loginError.textContent = 'Account aangemaakt! Log nu in.';
    isRegister = false;
    formTitle.textContent = 'Inloggen';
    loginSubmit.textContent = 'Inloggen';
    switchBtn.textContent = 'Nog geen account? Registreer';
    return;
  }

  // Inloggen
  if (!users[username] || users[username].password !== password) {
    loginError.textContent = 'Verkeerde gebruikersnaam of wachtwoord.';
    return;
  }
  currentUser = username;
  loginScreen.style.display = 'none';
  desktop.style.display = 'block';
  initDesktop();
});

// ========== DESKTOP INIT ==========
function initDesktop() {
  updateClock();
  setInterval(updateClock, 1000);
  document.getElementById('start-btn').addEventListener('click', showStartMenu);
  // Laad opgeslagen vensters voor deze gebruiker (als die er zijn)
  const data = getUserData(currentUser);
  if (data && data.windows) {
    data.windows.forEach(winData => {
      createWindow(winData.app, winData.title, winData.x, winData.y, winData.width, winData.height, winData.content);
    });
  }
}

function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent = now.toLocaleTimeString('nl-NL', {hour:'2-digit', minute:'2-digit'});
}

// ========== VENSTEREN BEHEER ==========
function createWindow(app, title, x=100, y=80, width=400, height=300, savedContent=null) {
  const id = windowIdCounter++;
  const win = document.createElement('div');
  win.className = 'window';
  win.dataset.id = id;
  win.style.left = x + 'px';
  win.style.top = y + 'px';
  win.style.width = width + 'px';
  win.style.height = height + 'px';
  win.style.zIndex = ++zIndexCounter;

  win.innerHTML = `
    <div class="titlebar">
      <span>${title || app}</span>
      <div>
        <button class="minimize-btn">—</button>
        <button class="close-btn">✕</button>
      </div>
    </div>
    <div class="content"></div>
  `;

  const content = win.querySelector('.content');
  // App-specifieke inhoud
  if (app === 'notepad') {
    content.classList.add('app-notepad');
    const ta = document.createElement('textarea');
    ta.value = savedContent || '';
    content.appendChild(ta);
    ta.addEventListener('input', saveAllWindows);
  } else if (app === 'calculator') {
    content.classList.add('app-calculator');
    content.innerHTML = `<div class="display" id="calc-display-${id}">0</div>`;
    const btns = ['7','8','9','+','4','5','6','-','1','2','3','*','C','0','=','/'];
    btns.forEach(b => {
      const btn = document.createElement('button');
      btn.textContent = b;
      btn.addEventListener('click', () => calcInput(b, id));
      content.appendChild(btn);
    });
    if (savedContent) {
      const disp = content.querySelector('.display');
      disp.textContent = savedContent;
    }
  } else if (app === 'klok') {
    content.innerHTML = `<div style="text-align:center;font-size:3rem;margin-top:20px;" id="klok-${id}"></div>`;
    updateAppClock(id);
    setInterval(() => updateAppClock(id), 1000);
  } else if (app === 'bestandsbeheer') {
    content.classList.add('app-filemanager');
    renderFiles(content, savedContent);
  }

  // Titelbalk functionaliteit
  const titlebar = win.querySelector('.titlebar');
  let isDragging = false, dragOffX, dragOffY;
  titlebar.addEventListener('mousedown', (e) => {
    if (e.target.tagName === 'BUTTON') return;
    isDragging = true;
    dragOffX = e.clientX - win.offsetLeft;
    dragOffY = e.clientY - win.offsetTop;
    win.style.zIndex = ++zIndexCounter;
  });
  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    win.style.left = (e.clientX - dragOffX) + 'px';
    win.style.top = (e.clientY - dragOffY) + 'px';
    saveAllWindows();
  });
  document.addEventListener('mouseup', () => { isDragging = false; });

  win.querySelector('.close-btn').addEventListener('click', () => {
    win.remove();
    windows = windows.filter(w => w.id !== id);
    updateTaskbar();
    saveAllWindows();
  });
  win.querySelector('.minimize-btn').addEventListener('click', () => {
    win.style.display = 'none';
    // We houden het venster in de lijst maar verbergen
    const task = document.querySelector(`.task[data-id="${id}"]`);
    if (task) task.classList.remove('active');
  });

  // Dubbelklik op titelbalk om te maximaliseren (optioneel)
  titlebar.addEventListener('dblclick', () => {
    if (win.style.width === '100vw') {
      win.style.width = '400px';
      win.style.height = '300px';
      win.style.left = '100px';
      win.style.top = '80px';
    } else {
      win.style.width = '100vw';
      win.style.height = 'calc(100vh - 50px)';
      win.style.left = '0';
      win.style.top = '0';
    }
    saveAllWindows();
  });

  desktop.insertBefore(win, document.getElementById('taskbar'));
  windows.push({ id, app, title, win, content });
  addTask(id, title || app);
  updateTaskbar();
  saveAllWindows();
  return win;
}

function addTask(id, label) {
  const taskList = document.getElementById('task-list');
  const task = document.createElement('span');
  task.className = 'task active';
  task.dataset.id = id;
  task.textContent = label;
  task.addEventListener('click', () => {
    const win = windows.find(w => w.id === id);
    if (!win) return;
    if (win.win.style.display === 'none') {
      win.win.style.display = 'flex';
      task.classList.add('active');
      win.win.style.zIndex = ++zIndexCounter;
    } else {
      win.win.style.zIndex = ++zIndexCounter;
    }
  });
  taskList.appendChild(task);
}

function updateTaskbar() {
  // taken synchroniseren met bestaande vensters
  const taskList = document.getElementById('task-list');
  taskList.innerHTML = '';
  windows.forEach(w => {
    const task = document.createElement('span');
    task.className = 'task active';
    task.dataset.id = w.id;
    task.textContent = w.title || w.app;
    task.addEventListener('click', () => {
      const win = windows.find(x => x.id === w.id);
      if (!win) return;
      if (win.win.style.display === 'none') {
        win.win.style.display = 'flex';
        task.classList.add('active');
        win.win.style.zIndex = ++zIndexCounter;
      } else {
        win.win.style.zIndex = ++zIndexCounter;
      }
    });
    taskList.appendChild(task);
  });
}

// ========== APP FUNCTIES ==========
// Calculator
function calcInput(value, id) {
  const win = windows.find(w => w.id === id);
  if (!win) return;
  const disp = win.content.querySelector('.display');
  let current = disp.textContent;
  if (value === 'C') { disp.textContent = '0'; saveAllWindows(); return; }
  if (value === '=') {
    try { disp.textContent = eval(current.replace('×','*').replace('÷','/')); } catch { disp.textContent = 'Fout'; }
    saveAllWindows(); return;
  }
  if (current === '0' && value !== '.') current = '';
  disp.textContent = current + value;
  saveAllWindows();
}

// Klok
function updateAppClock(id) {
  const el = document.getElementById(`klok-${id}`);
  if (el) el.textContent = new Date().toLocaleTimeString('nl-NL');
}

// Bestandsbeheer
function renderFiles(container, savedContent) {
  const data = getUserData(currentUser);
  const files = (savedContent && savedContent.files) ? savedContent.files : (data.files || []);
  container.innerHTML = '<div style="margin-bottom:6px;"><button class="new-file-btn">+ Nieuw bestand</button></div>';
  files.forEach((f, idx) => {
    const div = document.createElement('div');
    div.className = 'file';
    div.textContent = f.name;
    div.addEventListener('click', () => {
      // Open een notitieblok met de inhoud van het bestand
      const newWin = createWindow('notepad', 'Bestand: ' + f.name, 200+idx*30, 100+idx*30, 400, 300, f.content);
    });
    container.appendChild(div);
  });
  container.querySelector('.new-file-btn').addEventListener('click', () => {
    const name = prompt('Bestandsnaam:');
    if (!name) return;
    const data = getUserData(currentUser);
    data.files = data.files || [];
    data.files.push({ name: name, content: '' });
    setUserData(currentUser, data);
    // Herlaad alle bestandsbeheer vensters
    windows.filter(w => w.app === 'bestandsbeheer').forEach(w => renderFiles(w.content, null));
    saveAllWindows();
  });
}

// ========== STARTMENU (simpel) ==========
function showStartMenu() {
  // Toon een popup met apps om te openen
  const menu = document.createElement('div');
  menu.style.position = 'absolute';
  menu.style.bottom = '50px';
  menu.style.left = '0';
  menu.style.background = '#2a2a3e';
  menu.style.borderRadius = '8px';
  menu.style.padding = '10px';
  menu.style.zIndex = '2000';
  menu.style.boxShadow = '0 4px 20px black';
  APPS.forEach(app => {
    const btn = document.createElement('button');
    btn.textContent = app.charAt(0).toUpperCase() + app.slice(1);
    btn.style.display = 'block';
    btn.style.width = '100%';
    btn.style.padding = '10px';
    btn.style.margin = '4px 0';
    btn.style.background = '#3a3a5a';
    btn.style.border = 'none';
    btn.style.color = 'white';
    btn.style.cursor = 'pointer';
    btn.style.borderRadius = '6px';
    btn.addEventListener('click', () => {
      menu.remove();
      // Willekeurige positie
      const x = 100 + Math.random() * 200;
      const y = 80 + Math.random() * 100;
      createWindow(app, app, x, y);
    });
    menu.appendChild(btn);
  });
  // Sluitknop
  const closeBtn = document.createElement('button');
  closeBtn.textContent = 'Sluiten';
  closeBtn.style.width = '100%';
  closeBtn.style.padding = '6px';
  closeBtn.style.marginTop = '8px';
  closeBtn.style.background = '#e94560';
  closeBtn.style.border = 'none';
  closeBtn.style.color = 'white';
  closeBtn.style.cursor = 'pointer';
  closeBtn.style.borderRadius = '6px';
  closeBtn.addEventListener('click', () => menu.remove());
  menu.appendChild(closeBtn);
  desktop.appendChild(menu);
  // Klik buiten sluit menu
  setTimeout(() => {
    document.addEventListener('click', function closeMenu(e) {
      if (!menu.contains(e.target) && e.target !== document.getElementById('start-btn')) {
        menu.remove();
        document.removeEventListener('click', closeMenu);
      }
    });
  }, 0);
}

// ========== OPSLAAN VAN ALLE VENSTERS ==========
function saveAllWindows() {
  if (!currentUser) return;
  const data = getUserData(currentUser);
  const windowsData = windows.map(w => {
    const rect = w.win.getBoundingClientRect();
    let content = null;
    if (w.app === 'notepad') {
      const ta = w.content.querySelector('textarea');
      if (ta) content = ta.value;
    } else if (w.app === 'calculator') {
      const disp = w.content.querySelector('.display');
      if (disp) content = disp.textContent;
    } else if (w.app === 'bestandsbeheer') {
      // We slaan de bestandenlijst op via getUserData al apart, maar ook in venstercontent?
      content = { files: data.files }; // verwijzing
    }
    return {
      app: w.app,
      title: w.title,
      x: rect.left,
      y: rect.top,
      width: rect.width,
      height: rect.height,
      content: content
    };
  });
  data.windows = windowsData;
  // Zorg dat files bewaard blijven
  if (!data.files) data.files = [];
  setUserData(currentUser, data);
}

// ========== AUTO OPSLAAN BIJ VERANDERINGEN ==========
// Wordt al aangeroepen bij input, calc, en bij sluiten/verplaatsen (via mousemove)

// ========== OPNIEUW INLOGGEN NA REFRESH ==========
// We kunnen checken of er een "remembered" user is (optioneel)
// Voor nu: gebruiker moet opnieuw inloggen. Maar we kunnen een remember-me toevoegen.
// Simpelweg: als localStorage een 'myos_lastuser' heeft met token, kunnen we automatisch inloggen.
// Voor de eenvoud laten we dit achterwege; alle data blijft bewaard in localStorage per gebruiker.

// ========== INIT ==========
console.log('My-OS geladen. Registreer of log in.');
</script>
</body>
</html>
